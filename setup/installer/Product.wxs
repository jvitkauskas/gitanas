        <ProgId Id="Gitanas" Description="Gitanas Shortcut" Advertise="no">
          <Extension Id="gitext">
            <Verb Id="open" Command="Open Gitanas Repository" TargetFile="Gitanas.exe" Argument="openrepo &quot;%1&quot;" />
          </Extension>
        </ProgId>
