<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:c="using:GitUI.Avalonia.Controls"
                xmlns:b="using:GitUI.Avalonia.Controls.Blame"
                xmlns:bd="using:GitUI.Avalonia.CommandsDialogs.BrowseDialog"
                xmlns:ed="using:GitUI.Avalonia.Editor"
                xmlns:fs="using:GitUI.Avalonia.Controls.FileStatusList"
                xmlns:lp="using:GitUI.Avalonia.Controls.LeftPanel"
                xmlns:rg="using:GitUI.Avalonia.Controls.RevisionGrid"
                xmlns:s="using:GitUI.Avalonia.CommandsDialogs.SettingsDialog"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.BrowseDialog.BrowseWindow"
                x:DataType="vm:BrowseViewModel"
                Title="{Binding Title}"
                ShowInTaskbar="True"
                Width="1300" Height="900" MinWidth="600" MinHeight="400">
  <Window.Styles>
    <Style Selector="Button.toolbar, SplitButton.toolbar, ToggleButton.toolbar, DropDownButton.toolbar">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- The labels of the buttons, shown by the Modern theme only (Themes/Modern.axaml). -->
    <Style Selector="StackPanel.toolContent">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.toolLabel">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </Window.Styles>
  <!--
    Equivalent of FormBrowse: the main menu, the main toolbar (ToolStripMain), the grid and the tabs of the selected commit;
    without a valid repository, the dashboard instead of the toolbar, the grid and the tabs (as ShowDashboard).
  -->
  <DockPanel>
    <Menu Name="mainMenu" DockPanel.Dock="Top" />
    <WrapPanel Name="toolbar" DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="2" Margin="4,2" IsVisible="{Binding !IsDashboard}">
      <Button Name="refreshButton" Classes="toolbar" Command="{Binding RefreshRevisionsCommand}" ToolTip.Tip="{Binding Strings.Refresh.Text}" IsVisible="{Binding ToolbarItems[RefreshButton]}">
        <Image Source="avares://GitUI.Avalonia/Assets/ReloadRevisions.png" Width="16" Height="16" />
      </Button>
      <Separator Classes="toolbar" />
      <ToggleButton Name="toggleLeftPanel" Classes="toolbar" IsChecked="{Binding LeftPanel.IsVisible}" ToolTip.Tip="{Binding LeftPanel.Strings.ToggleLeftPanel.Text}">
        <ToggleButton.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="LeftPanel" Converter="{x:Static ObjectConverters.IsNotNull}" />
            <Binding Path="ToolbarItems[toggleLeftPanel]" />
          </MultiBinding>
        </ToggleButton.IsVisible>
        <Image Source="avares://GitUI.Avalonia/Assets/LayoutSidebarLeft.png" Width="16" Height="16" />
      </ToggleButton>
      <ToggleButton Name="toggleSplitViewLayout" Classes="toolbar" IsChecked="{Binding ShowSplitViewLayout, Mode=OneWay}" Command="{Binding ToggleSplitViewLayoutCommand}"
                    ToolTip.Tip="{Binding LayoutStrings.ToggleSplitViewLayout.Text}" IsVisible="{Binding ToolbarItems[toggleSplitViewLayout]}">
        <Image Source="avares://GitUI.Avalonia/Assets/LayoutFooter.png" Width="16" Height="16" />
      </ToggleButton>
      <DropDownButton Name="commitInfoPositionButton" Classes="toolbar" ToolTip.Tip="{Binding LayoutStrings.CommitInfoPosition.Text}" IsVisible="{Binding ToolbarItems[menuCommitInfoPosition]}">
        <Image Source="{Binding CommitInfoPositionIcon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="16" Height="16" />
      </DropDownButton>
      <Separator Classes="toolbar" />
      <SplitButton Name="submodulesButton" Classes="toolbar" IsEnabled="{Binding CanShowSubmodules}" ToolTip.Tip="{Binding SubmodulesToolTip}" IsVisible="{Binding ToolbarItems[toolStripButtonLevelUp]}">
        <Image Source="{Binding SubmodulesIcon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="16" Height="16" />
      </SplitButton>
      <SplitButton Name="worktreesButton" Classes="toolbar" ToolTip.Tip="{Binding ToolbarStrings.WorktreesToolTip.Text}"
                   Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.ManageWorktrees}">
        <SplitButton.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ShowWorktrees" />
            <Binding Path="ToolbarItems[toolStripWorktrees]" />
          </MultiBinding>
        </SplitButton.IsVisible>
        <Image Source="avares://GitUI.Avalonia/Assets/WorkTree.png" Width="16" Height="16" />
      </SplitButton>
      <DropDownButton Name="workingDirButton" Classes="toolbar" ToolTip.Tip="{Binding ToolbarStrings.WorkingDirToolTip.Text}" IsVisible="{Binding ToolbarItems[_NO_TRANSLATE_WorkingDir]}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Image Source="avares://GitUI.Avalonia/Assets/RepoOpen.png" Width="16" Height="16" />
          <!-- A long path keeps the toolbar on one row: the middle folders are trimmed (the tooltip names the repository). -->
          <TextBlock Text="{Binding WorkingDirectoryText}" VerticalAlignment="Center" MaxWidth="300" TextTrimming="PathSegmentEllipsis" />
        </StackPanel>
      </DropDownButton>
      <Button Name="branchButton" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.CheckoutBranch}" ToolTip.Tip="{Binding Strings.BranchToolTip.Text}" IsVisible="{Binding ToolbarItems[branchSelect]}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Image Source="avares://GitUI.Avalonia/Assets/BranchCheckout.png" Width="16" Height="16" />
          <TextBlock Text="{Binding CurrentBranch}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Separator Classes="toolbar" />
      <StackPanel Name="fetchPullShortcuts" Orientation="Horizontal" Spacing="2" />
      <SplitButton Name="pullButton" ToolTip.Tip="{Binding PullButtonToolTip}" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.PullDefault}" IsVisible="{Binding ToolbarItems[toolStripButtonPull]}">
        <!-- As toolStripButtonPull: the icon only (its tooltip names the pull action); the Modern theme adds the label. -->
        <StackPanel Classes="toolContent">
          <Image Source="{Binding PullButtonIcon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="16" Height="16" />
          <TextBlock Classes="toolLabel" Text="{Binding Strings.PullButton.Text}" />
        </StackPanel>
      </SplitButton>
      <Button Name="pushButton" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.Push}" IsVisible="{Binding ToolbarItems[toolStripButtonPush]}"
              ToolTip.Tip="{Binding Strings.PushButton.Text}">
        <!-- As toolStripButtonPush: the icon only; the Modern theme adds the label. -->
        <StackPanel Classes="toolContent">
          <Image Source="avares://GitUI.Avalonia/Assets/Push.png" Width="16" Height="16" />
          <TextBlock Classes="toolLabel" Text="{Binding Strings.PushButton.Text}" />
        </StackPanel>
      </Button>
      <!-- As ToolStripMain: Pull, Push, Commit, Stash. -->
      <Button Name="commitButton" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.Commit}" IsVisible="{Binding ToolbarItems[toolStripButtonCommit]}">
        <StackPanel Classes="toolContent commit">
          <Image Name="commitButtonIcon" Source="{Binding CommitButtonIcon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="16" Height="16" />
          <TextBlock Name="commitButtonText" Text="{Binding CommitButtonText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <SplitButton Name="stashButton" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.ManageStashes}" ToolTip.Tip="{Binding Strings.ManageStashesToolTip.Text}" IsVisible="{Binding ToolbarItems[toolStripSplitStash]}">
        <StackPanel Classes="toolContent">
          <Image Source="avares://GitUI.Avalonia/Assets/Stash.png" Width="16" Height="16" />
          <TextBlock Classes="toolLabel" Text="{Binding Strings.StashChanges.PlainText}" />
        </StackPanel>
      </SplitButton>
      <Separator Classes="toolbar" />
      <Button Name="fileExplorerButton" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.FileExplorer}" ToolTip.Tip="{Binding Strings.FileExplorerToolTip.Text}" IsVisible="{Binding ToolbarItems[toolStripFileExplorer]}">
        <Image Source="avares://GitUI.Avalonia/Assets/BrowseFileExplorer.png" Width="16" Height="16" />
      </Button>
      <SplitButton Name="userShellButton" Classes="toolbar" ToolTip.Tip="{Binding DefaultShell.Name}">
        <SplitButton.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="HasShells" />
            <Binding Path="ToolbarItems[userShell]" />
          </MultiBinding>
        </SplitButton.IsVisible>
        <Image Source="{Binding DefaultShell.Icon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="16" Height="16" />
      </SplitButton>
      <Button Name="gitBashButton" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.GitBash}" ToolTip.Tip="{Binding Strings.GitBashToolTip.Text}">
        <Button.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!HasShells" />
            <Binding Path="ToolbarItems[userShell]" />
          </MultiBinding>
        </Button.IsVisible>
        <Image Source="avares://GitUI.Avalonia/Assets/GitForWindows.png" Width="16" Height="16" />
      </Button>
      <Button Name="settingsButton" Classes="toolbar" Command="{Binding RunCommand}" CommandParameter="{x:Static vm:BrowseCommand.Settings}" ToolTip.Tip="{Binding Strings.SettingsToolTip.Text}" IsVisible="{Binding ToolbarItems[EditSettings]}">
        <Image Source="avares://GitUI.Avalonia/Assets/Settings.png" Width="16" Height="16" />
      </Button>
      <Separator Classes="toolbar" />
      <StackPanel Name="scriptsToolBar" Orientation="Horizontal" Spacing="2" IsVisible="{Binding ShowScriptsToolbar}" />
      <Panel Name="filterToolBarHost" IsVisible="{Binding ShowFiltersToolbar}">
        <rg:FilterToolBarView Name="filterToolBar" DataContext="{Binding Filters}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </Panel>
    </WrapPanel>
    <!-- The left panel (RepoObjectsTree in MainSplitContainer.Panel1) beside the grid and the tabs. -->
    <Grid Name="mainSplit" ColumnDefinitions="260,Auto,*" Margin="4,0,4,4">
    <!-- The left panel, and below it the output history panel (OutputHistoryPanelController in LeftSplitContainer.Panel2). -->
    <Grid Name="leftColumn" RowDefinitions="*,Auto,200">
      <lp:LeftPanelView Name="leftPanel" DataContext="{Binding LeftPanel}" />
      <GridSplitter Name="outputHistoryPanelSplitter" Grid.Row="1" Height="5" ResizeDirection="Rows" Background="Transparent" IsVisible="False" />
      <TextBox Name="outputHistoryPanel" Grid.Row="2" Text="{Binding OutputHistoryText}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" IsVisible="False"
               FontFamily="{DynamicResource MonospaceFontFamily}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <TextBox.ContextMenu>
          <ContextMenu>
            <MenuItem Name="copyOutputHistoryPanelItem" Header="{Binding OutputHistoryStrings.Copy.AccessKeyText}" />
            <MenuItem Header="{Binding OutputHistoryStrings.Clear.AccessKeyText}" Command="{Binding ClearOutputHistoryCommand}" />
          </ContextMenu>
        </TextBox.ContextMenu>
      </TextBox>
    </Grid>
    <GridSplitter Name="leftPanelSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent" />
    <Grid Name="contentGrid" Grid.Column="2" RowDefinitions="*,Auto,320">
      <!-- The commit info beside the grid (CommitInfoPosition LeftwardFromList / RightwardFromList), else in its tab. -->
      <Grid Name="gridArea" ColumnDefinitions="0,Auto,*,Auto,0" IsVisible="{Binding !IsDashboard}">
        <ContentControl Name="leftCommitInfoHost" IsVisible="False" />
        <GridSplitter Name="leftCommitInfoSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent" IsVisible="False" />
        <Border Grid.Column="2" Classes="frame" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <rg:RevisionGridView Name="revisionGrid" DataContext="{Binding Grid}" />
        </Border>
        <GridSplitter Name="rightCommitInfoSplitter" Grid.Column="3" Width="5" ResizeDirection="Columns" Background="Transparent" IsVisible="False" />
        <ContentControl Name="rightCommitInfoHost" Grid.Column="4" IsVisible="False" />
      </Grid>
      <GridSplitter Name="tabsSplitter" Grid.Row="1" Height="5" ResizeDirection="Rows" Background="Transparent" IsVisible="{Binding ShowTabs}" />
      <TabControl Name="tabs" Grid.Row="2" Padding="0,4,0,0" IsVisible="{Binding ShowTabs}">
        <TabItem Name="commitTab" IsVisible="{Binding IsCommitInfoInTab}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/CommitSummary.png" Width="16" Height="16" />
              <TextBlock Text="{Binding Strings.CommitTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <Border Name="commitInfoBorder" Classes="frame" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <c:CommitInfoView Name="commitInfo" DataContext="{Binding CommitInfo}" />
          </Border>
        </TabItem>
        <TabItem Name="diffTab">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Diff.png" Width="16" Height="16" />
              <TextBlock Text="{Binding Strings.DiffTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <!-- The "RevisionDiff" hotkeys apply in the tab (the RevisionDiffControl). -->
          <h:HotkeyGrid Name="diffPanel" ColumnDefinitions="300,Auto,*">
            <fs:FileStatusListView Name="diffFiles" DataContext="{Binding Files}" />
            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent" />
            <Border Grid.Column="2" Classes="frame" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <!-- As the BlameControl of RevisionDiffControl: the blame instead of the viewer while "Blame" is checked. -->
              <Panel>
                <Panel IsVisible="{Binding !IsDiffBlameVisible}">
                  <ed:FileViewerView Name="diffViewer" DataContext="{Binding Viewer}" />
                </Panel>
                <Panel IsVisible="{Binding IsDiffBlameVisible}">
                  <b:BlameView Name="diffBlame" DataContext="{Binding DiffBlame}" />
                </Panel>
              </Panel>
            </Border>
          </h:HotkeyGrid>
        </TabItem>
        <TabItem Name="treeTab" IsVisible="{Binding FileTree, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/FileTree.png" Width="16" Height="16" />
              <TextBlock Text="{Binding Strings.TreeTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <h:HotkeyGrid Name="treePanel" ColumnDefinitions="300,Auto,*">
            <fs:FileStatusListView Name="treeFiles" DataContext="{Binding FileTree}" />
            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent" />
            <Border Grid.Column="2" Classes="frame" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <!-- As the BlameControl of RevisionDiffControl: the blame instead of the viewer while "Blame" is checked. -->
              <Panel>
                <Panel IsVisible="{Binding !IsTreeBlameVisible}">
                  <ed:FileViewerView Name="treeViewer" DataContext="{Binding TreeViewer}" />
                </Panel>
                <Panel IsVisible="{Binding IsTreeBlameVisible}">
                  <b:BlameView Name="treeBlame" DataContext="{Binding TreeBlame}" />
                </Panel>
              </Panel>
            </Border>
          </h:HotkeyGrid>
        </TabItem>
        <TabItem Name="gpgTab" IsVisible="{Binding HasGpgInfo}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Key.png" Width="16" Height="16" />
              <TextBlock Text="{Binding GpgStrings.GpgTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <!-- Equivalent of RevisionGpgInfoControl: the signature of the commit, then of its tags if it has any. -->
          <UniformGrid Columns="1" Margin="6">
            <DockPanel>
              <Image DockPanel.Dock="Left" Source="{Binding CommitGpgIcon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,6,0"
                     IsVisible="{Binding CommitGpgIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBox Name="commitGpgInfo" Text="{Binding CommitGpgText}" IsReadOnly="True" TextWrapping="Wrap" />
            </DockPanel>
            <DockPanel Margin="0,6,0,0" IsVisible="{Binding TagGpgText, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Image DockPanel.Dock="Left" Source="{Binding TagGpgIcon, Converter={x:Static s:SettingsIconConverter.Instance}}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,6,0"
                     IsVisible="{Binding TagGpgIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <TextBox Name="tagGpgInfo" Text="{Binding TagGpgText}" IsReadOnly="True" TextWrapping="Wrap" />
            </DockPanel>
          </UniformGrid>
        </TabItem>
        <TabItem Name="consoleTab" IsVisible="{Binding HasConsole}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Console.png" Width="16" Height="16" />
              <TextBlock Text="{Binding Strings.ConsoleTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <!-- The terminal of the configured console emulator (ConEmu or Mintty), a WinForms control as a child window. -->
          <c:EmbeddedNativeViewPresenter Name="consoleView" View="{Binding ConsoleView}" />
        </TabItem>
        <TabItem Name="outputHistoryTab" IsVisible="{Binding IsOutputHistoryTab}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/GitCommandLog.png" Width="16" Height="16" />
              <TextBlock Text="{Binding OutputHistoryStrings.Tab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <!-- Equivalent of OutputHistoryControl: the output of the git commands, with Copy and Clear. -->
          <TextBox Name="outputHistory" Text="{Binding OutputHistoryText}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                   FontFamily="{DynamicResource MonospaceFontFamily}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <TextBox.ContextMenu>
              <ContextMenu>
                <MenuItem Name="copyOutputHistoryItem" Header="{Binding OutputHistoryStrings.Copy.AccessKeyText}" />
                <MenuItem Header="{Binding OutputHistoryStrings.Clear.AccessKeyText}" Command="{Binding ClearOutputHistoryCommand}" />
              </ContextMenu>
            </TextBox.ContextMenu>
          </TextBox>
        </TabItem>
        <!-- BuildReportTabPageExtension: the report of the build status of the selected revision, or a link to it. -->
        <TabItem Name="buildReportTab" IsVisible="{Binding HasBuildReport}" PropertyChanged="OnBuildReportTabPropertyChanged">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <!-- The favicon of the report, once shown (the image of BuildReportTabPageExtension). -->
              <Panel Width="16" Height="16">
                <Image Width="16" Height="16" Source="avares://GitUI.Avalonia/Assets/Integration.png" IsVisible="{Binding BuildReportIcon, Converter={x:Static ObjectConverters.IsNull}}" />
                <Image Name="buildReportIcon" Source="{Binding BuildReportIcon, Converter={x:Static rg:AvatarConverter.Instance}}"
                       IsVisible="{Binding BuildReportIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Panel>
              <TextBlock Text="{Binding BuildReportStrings.BuildReportTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <Panel>
            <c:EmbeddedNativeViewPresenter Name="buildReportView" View="{Binding BuildReportView}" IsVisible="{Binding IsBuildReportInTab}" />
            <Button Name="openBuildReport" Classes="link" Command="{Binding OpenBuildReportCommand}" IsVisible="{Binding !IsBuildReportInTab}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand">
              <TextBlock Text="{Binding BuildReportStrings.OpenReport.Text}" FontSize="21" TextDecorations="Underline"
                         Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
            </Button>
          </Panel>
        </TabItem>
      </TabControl>
      <bd:DashboardView Name="dashboard" Grid.RowSpan="3" Margin="-4,0,-4,-4" DataContext="{Binding Dashboard}" IsVisible="{Binding $parent[Window].((vm:BrowseViewModel)DataContext).IsDashboard}" />
    </Grid>
    </Grid>
  </DockPanel>
</h:DialogWindow>
