<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:h="using:GitUI.Avalonia.Hosting"
             xmlns:vm="using:GitUI.Presentation.CommandsDialogs.BrowseDialog"
             xmlns:sd="using:GitUI.Avalonia.CommandsDialogs.SettingsDialog"
             xmlns:local="using:GitUI.Avalonia.CommandsDialogs.BrowseDialog"
             x:Class="GitUI.Avalonia.CommandsDialogs.BrowseDialog.DashboardView"
             x:DataType="vm:DashboardViewModel"
             DragDrop.AllowDrop="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <!--
        DashboardTheme: Light is the paletton palette of the WinForms dashboard, Dark its SystemColors of a dark theme. The
        background image is tiled at its size, as the BackgroundImageLayout of the WinForms dashboard.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="DashboardWindowBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DashboardSearchBackBrush" Color="#F8F8FF" />
          <SolidColorBrush x:Key="DashboardStartBackBrush" Color="#DBEBF8" />
          <SolidColorBrush x:Key="DashboardContributeBackBrush" Color="#E6F1FA" />
          <SolidColorBrush x:Key="DashboardHeaderBackBrush" Color="#ACD0EF" />
          <SolidColorBrush x:Key="DashboardLogoBackBrush" Color="#137AD4" />
          <SolidColorBrush x:Key="DashboardPrimaryTextBrush" Color="#1E1E1E" />
          <SolidColorBrush x:Key="DashboardSecondaryTextBrush" Color="#647FD2" />
          <SolidColorBrush x:Key="DashboardAccentedTextBrush" Color="DarkGoldenrod" />
          <SolidColorBrush x:Key="DashboardSecondaryHeadingBrush" Color="DimGray" />
          <SolidColorBrush x:Key="DashboardGroupHeaderBrush" Color="#1E3287" />
          <SolidColorBrush x:Key="DashboardGroupLineBrush" Color="#DDE3F0" />
          <ImageBrush x:Key="DashboardBackgroundBrush" Source="avares://GitUI.Avalonia/Assets/DashboardBackgroundBlue.png"
                      TileMode="Tile" Stretch="Fill" DestinationRect="0,0,1240,940" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="DashboardWindowBrush" Color="#1E1E1E" />
          <SolidColorBrush x:Key="DashboardSearchBackBrush" Color="#2D2D2D" />
          <SolidColorBrush x:Key="DashboardStartBackBrush" Color="#2D2D2D" />
          <SolidColorBrush x:Key="DashboardContributeBackBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="DashboardHeaderBackBrush" Color="#252525" />
          <SolidColorBrush x:Key="DashboardLogoBackBrush" Color="#151515" />
          <SolidColorBrush x:Key="DashboardPrimaryTextBrush" Color="#E6E6E6" />
          <SolidColorBrush x:Key="DashboardSecondaryTextBrush" Color="LightSkyBlue" />
          <SolidColorBrush x:Key="DashboardAccentedTextBrush" Color="#E8B53A" />
          <SolidColorBrush x:Key="DashboardSecondaryHeadingBrush" Color="#9A9A9A" />
          <SolidColorBrush x:Key="DashboardGroupHeaderBrush" Color="#99B4F5" />
          <SolidColorBrush x:Key="DashboardGroupLineBrush" Color="#3A3F4A" />
          <ImageBrush x:Key="DashboardBackgroundBrush" Source="avares://GitUI.Avalonia/Assets/DashboardBackgroundGrey.png"
                      TileMode="Tile" Stretch="Fill" DestinationRect="0,0,1399,939" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- The LinkLabels of the start and contribute panels: never underlined, accented under the mouse. -->
    <Style Selector="Button.dashboardLink">
      <Setter Property="Padding" Value="3" />
      <Setter Property="Margin" Value="3,0,3,8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource DashboardPrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.dashboardLink /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.dashboardLink:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource DashboardAccentedTextBrush}" />
    </Style>
    <!-- The tiles of the repositories (the owner-drawn ListView in tile view). -->
    <Style Selector="ListBox.tiles">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,2,2" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.tiles ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource DashboardStartBackBrush}" />
    </Style>
  </UserControl.Styles>
  <!-- Port of Dashboard: the logo, the start and contribute links on the left, the repositories (UserRepositoriesList) on the right. -->
  <Grid Name="layout" ColumnDefinitions="*,213,12*,*" Background="{DynamicResource DashboardBackgroundBrush}">
    <DockPanel Grid.Column="1">
      <Border Name="logoPanel" DockPanel.Dock="Top" Height="70" Background="{DynamicResource DashboardLogoBackBrush}" Padding="14,15,14,11">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Image Source="avares://GitUI.Avalonia/Assets/GitanasLogo256.png" Width="44" Height="44" />
          <TextBlock Text="Gitanas" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Name="contributePanel" DockPanel.Dock="Bottom" Background="{DynamicResource DashboardContributeBackBrush}" Padding="20,20,20,30">
        <StackPanel>
          <TextBlock Name="contributeLabel" Text="{Binding Strings.Contribute.Text}" Margin="2,0,2,8"
                     FontSize="{DynamicResource DashboardHeadingFontSize}" Foreground="{DynamicResource DashboardSecondaryHeadingBrush}" />
          <ItemsControl Name="contributeLinks" ItemsSource="{Binding ContributeLinks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DashboardLinkItem">
                <Button Classes="dashboardLink" Command="{Binding Command}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{Binding Icon, Converter={x:Static sd:SettingsIconConverter.Instance}}" Width="16" Height="16" h:ImageLightness.Adapt="{Binding AdaptsLightness}" />
                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Name="startPanel" Background="{DynamicResource DashboardStartBackBrush}" Padding="20">
        <ItemsControl Name="startLinks" ItemsSource="{Binding StartLinks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DashboardLinkItem">
              <Button Classes="dashboardLink" Command="{Binding Command}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Source="{Binding Icon, Converter={x:Static sd:SettingsIconConverter.Instance}}" Width="16" Height="16" />
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </DockPanel>
    <DockPanel Grid.Column="2" Background="{DynamicResource DashboardWindowBrush}">
      <Border DockPanel.Dock="Top" Height="70" Background="{DynamicResource DashboardHeaderBackBrush}" Padding="20,0,20,11">
        <TextBlock Name="recentRepositoriesLabel" Text="{Binding ListStrings.RecentRepositories.Text}" VerticalAlignment="Bottom"
                   FontSize="{DynamicResource DashboardHeadingFontSize}" Foreground="{DynamicResource DashboardSecondaryHeadingBrush}" />
      </Border>
      <DockPanel Margin="20,18,20,3">
        <TextBox Name="searchBox" DockPanel.Dock="Top" Margin="3" Text="{Binding SearchText}"
                 PlaceholderText="{Binding ListStrings.SearchPlaceholder.Text}" Background="{DynamicResource DashboardSearchBackBrush}" />
        <ScrollViewer Name="repositoriesScroller" Margin="0,12,0,0" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl Name="groups" ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DashboardGroup">
                <StackPanel Margin="0,0,0,10">
                  <!-- The ListView group header, with its task link ("Actions"). -->
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,4">
                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource DashboardGroupHeaderBrush}" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Height="1" Margin="8,0" VerticalAlignment="Center" Background="{DynamicResource DashboardGroupLineBrush}" />
                    <Button Grid.Column="2" Classes="link groupActions"
                            Content="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).ListStrings.GroupActions.Text}" />
                  </Grid>
                  <ListBox Classes="tiles" ItemsSource="{Binding Items}" SelectionMode="Single"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:DashboardRepositoryItem">
                        <Grid ColumnDefinitions="40,*" MinHeight="50" ToolTip.Tip="{Binding Path}"
                              Width="{Binding $parent[local:DashboardView].TileWidth}">
                          <Panel VerticalAlignment="Top" Margin="4,8,0,0">
                            <Image Source="avares://GitUI.Avalonia/Assets/DashboardFolderGit.png" Width="32" Height="32" IsVisible="{Binding !IsInvalid}" />
                            <Image Source="avares://GitUI.Avalonia/Assets/DashboardFolderError.png" Width="32" Height="32" IsVisible="{Binding IsInvalid}" />
                            <Image Source="avares://GitUI.Avalonia/Assets/Star.png" Width="16" Height="16" Margin="20,-6,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding HasCategory}" />
                          </Panel>
                          <StackPanel Grid.Column="1" Margin="4,6,6,4" Spacing="1">
                            <TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource DashboardPrimaryTextBrush}" />
                            <TextBlock Text="{Binding BranchName}" TextTrimming="CharacterEllipsis" FontSize="{DynamicResource DashboardSecondaryFontSize}"
                                       Foreground="{DynamicResource DashboardSecondaryTextBrush}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </DockPanel>
  </Grid>
</UserControl>
