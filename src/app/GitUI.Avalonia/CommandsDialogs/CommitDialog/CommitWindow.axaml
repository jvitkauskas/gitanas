<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:ed="using:GitUI.Avalonia.Editor"
                xmlns:fs="using:GitUI.Avalonia.Controls.FileStatusList"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs.CommitDialog"
                x:Class="GitUI.Avalonia.CommandsDialogs.CommitDialog.CommitWindow"
                x:DataType="vm:CommitViewModel"
                Title="{Binding Title}"
                ShowInTaskbar="True"
                Width="1200" Height="820" MinWidth="700" MinHeight="450">
  <Window.Styles>
    <Style Selector="Button.toolbar, DropDownButton.toolbar">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="StackPanel.commitButtons > Button">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.forced">
      <!-- As OtherColors.AmendButtonForcedColor. -->
      <Setter Property="Background" Value="#C0E66363" />
    </Style>
    <Style Selector="Separator.toolbar">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="4">
    <!-- Equivalent of the status bar: the committer, then on the right the branch and its remote, the staged files and the caret. -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Margin="2,4,2,0">
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <Image Source="avares://GitUI.Avalonia/Assets/Branch.png" Width="16" Height="16" />
        <TextBlock Name="branchName" Text="{Binding BranchName}" VerticalAlignment="Center" />
        <!-- As remoteNameLabel (IsLink): the remotes of the branch. -->
        <Button Name="pushTo" Classes="link" Command="{Binding EditRemotesCommand}" VerticalAlignment="Center"
                IsVisible="{Binding PushTo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding PushTo}" />
        </Button>
      </StackPanel>
      <!-- As commitAuthorStatus (IsLink): the committer settings. -->
      <Button Name="committerButton" Grid.Column="0" Classes="link" VerticalAlignment="Center" Command="{Binding EditCommitterCommand}"
              ToolTip.Tip="{Binding Strings.CommitCommitterToolTip.Text}">
        <TextBlock Text="{Binding Committer}" />
      </Button>
      <TextBlock Grid.Column="3" VerticalAlignment="Center">
        <Run Text="{Binding Strings.StagedCountLabel.Text}" />
        <Run Text="{Binding StagedCount}" />
      </TextBlock>
      <TextBlock Name="caret" Grid.Column="4" VerticalAlignment="Center" />
    </Grid>
    <Grid ColumnDefinitions="8*,Auto,17*">
      <!-- Equivalent of splitLeft: the unstaged files, then toolbarStaged above the staged files. -->
      <Grid RowDefinitions="Auto,*,Auto,Auto,*">
        <!-- The rescan is the Refresh button of the toolbar of the unstaged files, as in FormCommit. -->
        <StackPanel Orientation="Horizontal" Spacing="2">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Width="60" MinWidth="0" VerticalAlignment="Center" Margin="6,0" />
          <!-- Equivalent of toolbarSelectionFilter. -->
          <StackPanel Name="selectionFilterBar" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsSelectionFilterVisible}">
            <TextBlock Text="{Binding Strings.SelectionFilter.PlainText}" VerticalAlignment="Center" />
            <ComboBox Name="selectionFilter" IsEditable="True" Width="160" Padding="4,1" VerticalAlignment="Center"
                      ItemsSource="{Binding SelectionFilterHistory}" Text="{Binding SelectionFilter}" ToolTip.Tip="{Binding SelectionFilterToolTip}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <fs:FileStatusListView Name="unstagedFiles" DataContext="{Binding Unstaged}" />
        </Border>
        <GridSplitter Grid.Row="2" Height="5" ResizeDirection="Rows" Background="Transparent" />
        <!-- Equivalent of toolbarStaged: unstage on the left, stage on the right. -->
        <DockPanel Grid.Row="3" Margin="0,0,0,2">
          <Button Name="unstageAllButton" DockPanel.Dock="Left" Classes="toolbar" Command="{Binding UnstageAllCommand}" IsEnabled="{Binding CanStage}">
            <Image Name="unstageAllImage" Source="avares://GitUI.Avalonia/Assets/UnstageAll.png" Width="16" Height="16" />
          </Button>
          <Separator DockPanel.Dock="Left" Classes="toolbar" />
          <Button Name="unstageButton" DockPanel.Dock="Left" Classes="toolbar" Command="{Binding UnstageCommand}" IsEnabled="{Binding CanStage}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Unstage.png" Width="16" Height="16" />
              <AccessText Text="{Binding Strings.Unstage.AccessKeyText}" />
            </StackPanel>
          </Button>
          <Button Name="stageAllButton" DockPanel.Dock="Right" Classes="toolbar" Command="{Binding StageAllCommand}" IsEnabled="{Binding CanStage}">
            <Image Name="stageAllImage" Source="avares://GitUI.Avalonia/Assets/StageAll.png" Width="16" Height="16" />
          </Button>
          <Separator DockPanel.Dock="Right" Classes="toolbar" />
          <Button Name="stageButton" DockPanel.Dock="Right" Classes="toolbar" Command="{Binding StageCommand}" IsEnabled="{Binding CanStage}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Stage.png" Width="16" Height="16" />
              <AccessText Text="{Binding Strings.Stage.AccessKeyText}" />
            </StackPanel>
          </Button>
          <Panel />
        </DockPanel>
        <Border Grid.Row="4" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <fs:FileStatusListView Name="stagedFiles" DataContext="{Binding Staged}" />
        </Border>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent" />
      <!-- Equivalent of splitRight: the diff above the buttons and the message. -->
      <Grid Grid.Column="2" RowDefinitions="*,Auto,240">
        <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <ed:FileViewerView Name="diff" DataContext="{Binding Diff}" />
        </Border>
        <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" Background="Transparent" />
        <!-- Equivalent of tableLayoutPanel1: the buttons beside toolbarCommit and the message. -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,*" ColumnSpacing="6">
          <ScrollViewer Grid.RowSpan="2" MinWidth="170" MaxWidth="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="commitButtons" Spacing="4">
              <Button Name="solveMergeConflictsButton" Command="{Binding SolveMergeConflictsCommand}" IsVisible="{Binding HasMergeConflicts}"
                      Background="#C0E66363" FontWeight="Bold">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Image Source="avares://GitUI.Avalonia/Assets/SolveMerge.png" Width="16" Height="16" />
                  <TextBlock Text="{Binding Strings.SolveMergeConflicts.PlainText}" TextWrapping="Wrap" />
                </StackPanel>
              </Button>
              <Button Name="commitButton" Command="{Binding CommitCommand}" IsEnabled="{Binding CanCommit}">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Name="commitImage" Source="avares://GitUI.Avalonia/Assets/RepoStateClean.png" Width="16" Height="16" />
                  <AccessText Grid.Column="1" Text="{Binding Strings.Commit.AccessKeyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button Name="commitAndPushButton" Command="{Binding CommitAndPushCommand}"
                      IsEnabled="{Binding CanCommit}" IsVisible="{Binding Options.ShowCommitAndPush}" Classes.forced="{Binding IsPushForced}">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Source="avares://GitUI.Avalonia/Assets/ArrowUp.png" Width="16" Height="16" />
                  <AccessText Grid.Column="1" Text="{Binding CommitAndPushText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button Name="modifyMessageButton" Command="{Binding ModifyCommitMessageCommand}"
                      IsVisible="{Binding ShowModifyMessageButton}" ToolTip.Tip="{Binding Strings.ModifyCommitMessageButtonToolTip.Text}">
                <AccessText Text="{Binding Strings.ModifyCommitMessage.AccessKeyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
              </Button>
              <CheckBox Name="amend" Content="{Binding Strings.Amend.AccessKeyText}" IsChecked="{Binding Amend}" IsEnabled="{Binding IsAmendEnabled}" />
              <StackPanel Name="amendPanel" Margin="18,0,0,0" Spacing="4" IsVisible="{Binding Amend}">
                <CheckBox Name="resetAuthor" Content="{Binding Strings.ResetAuthor.AccessKeyText}" IsChecked="{Binding ResetAuthor}" />
                <Button Name="resetSoftButton" Command="{Binding ResetSoftCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        IsEnabled="{Binding CanResetSoft}" ToolTip.Tip="{Binding Strings.ResetSoftToolTip.Text}">
                  <Grid ColumnDefinitions="Auto,*">
                    <Image Source="avares://GitUI.Avalonia/Assets/ResetCurrentBranchToHere.png" Width="16" Height="16" />
                    <AccessText Grid.Column="1" Text="{Binding Strings.ResetSoft.AccessKeyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                  </Grid>
                </Button>
              </StackPanel>
              <CheckBox Name="stageInSuperproject" Content="{Binding Strings.StageInSuperproject.AccessKeyText}" IsChecked="{Binding StageInSuperproject}"
                        IsVisible="{Binding HasSuperproject}" ToolTip.Tip="{Binding Strings.StageInSuperprojectToolTip.Text}" />
              <Button Name="stashStagedButton" Command="{Binding StashStagedCommand}" IsVisible="{Binding Options.SupportStashStaged}">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Source="avares://GitUI.Avalonia/Assets/Stash.png" Width="16" Height="16" />
                  <AccessText Grid.Column="1" Text="{Binding Strings.StashStaged.AccessKeyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button Name="resetAllButton" Command="{Binding ResetAllChangesCommand}" IsEnabled="{Binding HasChanges}" IsVisible="{Binding Options.ShowResetAllChanges}">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Source="avares://GitUI.Avalonia/Assets/ResetWorkingDirChanges.png" Width="16" Height="16" />
                  <AccessText Grid.Column="1" Text="{Binding Strings.ResetAllChanges.AccessKeyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button Name="resetUnstagedButton" Command="{Binding ResetUnstagedChangesCommand}" IsEnabled="{Binding HasUnstagedChanges}" IsVisible="{Binding Options.ShowResetWorkTreeChanges}">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Source="avares://GitUI.Avalonia/Assets/ResetWorkingDirChanges.png" Width="16" Height="16" />
                  <AccessText Grid.Column="1" Text="{Binding Strings.ResetUnstagedChanges.AccessKeyText}" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </Button>
            </StackPanel>
          </ScrollViewer>
          <!-- Equivalent of toolbarCommit: previous messages, templates, create branch, and the options on the right. -->
          <!-- Keep every command reachable when the message pane is narrow. -->
          <WrapPanel Name="messageToolbar" Grid.Column="1" Margin="0,0,0,2">
            <DropDownButton Name="commitMessageButton" Classes="toolbar" IsEnabled="{Binding IsMessageEditable}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <Image Source="avares://GitUI.Avalonia/Assets/WorkingDirChanges.png" Width="16" Height="16" />
                <AccessText Grid.Column="1" TextWrapping="Wrap" Text="{Binding Strings.CommitMessageMenu.AccessKeyText}" />
              </Grid>
              <!-- A context menu opened by the button: the items of a MenuFlyout filled when opening are not shown. -->
              <DropDownButton.ContextMenu>
                <ContextMenu Placement="BottomEdgeAlignedLeft" />
              </DropDownButton.ContextMenu>
            </DropDownButton>
            <DropDownButton Name="commitTemplatesButton" Classes="toolbar" IsEnabled="{Binding IsMessageEditable}" ToolTip.Tip="{Binding Strings.CommitTemplatesToolTip.Text}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <Image Source="avares://GitUI.Avalonia/Assets/CommitTemplates.png" Width="16" Height="16" />
                <AccessText Grid.Column="1" TextWrapping="Wrap" Text="{Binding Strings.CommitTemplates.AccessKeyText}" />
              </Grid>
              <DropDownButton.ContextMenu>
                <ContextMenu Placement="BottomEdgeAlignedLeft" />
              </DropDownButton.ContextMenu>
            </DropDownButton>
            <Button Name="createBranchButton" Classes="toolbar" Command="{Binding CreateBranchCommand}" ToolTip.Tip="{Binding Strings.CreateBranchToolTip.Text}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                <Image Source="avares://GitUI.Avalonia/Assets/BranchCreate.png" Width="16" Height="16" />
                <AccessText Grid.Column="1" TextWrapping="Wrap" Text="{Binding Strings.CreateBranch.AccessKeyText}" />
              </Grid>
            </Button>
            <DropDownButton Name="optionsButton" Classes="toolbar" Content="{Binding Strings.Options.AccessKeyText}">
              <DropDownButton.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{Binding Strings.CloseDialogAfterEachCommit.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding CloseDialogAfterEachCommit}" />
                  <MenuItem Header="{Binding Strings.CloseDialogAfterAllFilesCommitted.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding CloseDialogAfterAllFilesCommitted}" />
                  <MenuItem Header="{Binding Strings.RefreshDialogOnFormFocus.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding RefreshDialogOnFormFocus}" />
                  <MenuItem Header="{Binding Strings.SelectStagedOnEnterMessage.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding SelectStagedOnEnterMessage}" />
                  <Separator />
                  <MenuItem Header="{Binding Strings.SignOff.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding SignOff}" />
                  <!-- Equivalent of toolAuthorLabelItem and toolAuthor. -->
                  <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Strings.AuthorLabel.PlainText}" />
                        <TextBox Name="author" Text="{Binding Author}" MinWidth="260" />
                      </StackPanel>
                    </MenuItem.Header>
                  </MenuItem>
                  <MenuItem Header="{Binding Strings.NoVerify.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding NoVerify}" />
                  <Separator />
                  <!-- Equivalent of gpgSignCommitToolStripComboBox and toolStripGpgKeyTextBox. -->
                  <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                      <StackPanel Spacing="2">
                        <ComboBox Name="gpgSign" MinWidth="230" ItemsSource="{x:Static vm:CommitViewModel.GpgSignModes}" SelectedIndex="{Binding GpgSignIndex}" />
                        <TextBox Name="gpgKey" MinWidth="230" Text="{Binding GpgKeyId}" IsVisible="{Binding IsGpgKeyVisible}" />
                      </StackPanel>
                    </MenuItem.Header>
                  </MenuItem>
                </MenuFlyout>
              </DropDownButton.Flyout>
            </DropDownButton>
          </WrapPanel>
          <Border Grid.Column="1" Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Panel>
              <!-- As Message.TextBoxFont = AppSettings.CommitFont. -->
              <ed:TextEditorView Name="message" Classes="commitMessage" DataContext="{Binding Message}" />
              <!-- Where the editor draws its first line, in its font (italic, as the WinForms watermark). -->
              <TextBlock Name="messageWatermark" Text="{Binding MessageWatermark}" IsHitTestVisible="False" Margin="1,2"
                         FontFamily="{DynamicResource CommitFontFamily}" FontSize="{DynamicResource CommitFontSize}" FontStyle="Italic"
                         Foreground="{DynamicResource TextControlPlaceholderForeground}" />
            </Panel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</h:DialogWindow>
