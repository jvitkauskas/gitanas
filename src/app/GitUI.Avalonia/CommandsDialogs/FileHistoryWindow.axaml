<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:c="using:GitUI.Avalonia.Controls"
                xmlns:b="using:GitUI.Avalonia.Controls.Blame"
                xmlns:ed="using:GitUI.Avalonia.Editor"
                xmlns:fs="using:GitUI.Avalonia.Controls.FileStatusList"
                xmlns:rg="using:GitUI.Avalonia.Controls.RevisionGrid"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                xmlns:hd="using:GitUI.Presentation.HelperDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.FileHistoryWindow"
                x:DataType="vm:FileHistoryViewModel"
                Title="{Binding Title}"
                ShowInTaskbar="True"
                Width="1100" Height="800" MinWidth="500" MinHeight="400">
  <Window.Styles>
    <Style Selector="Button.toolbar, DropDownButton.toolbar, SplitButton.toolbar">
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="MenuItem.caption">
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="4">
    <!-- Equivalent of ToolStripFilters with the items of FormFileHistory: the filters of the grid, Navigate and View. -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="2" Margin="0,0,0,4">
      <!-- Equivalent of the ToolStripSplitButton: loads the history, its drop down holds the "on show" options -->
      <SplitButton Name="loadButton" Classes="toolbar" Command="{Binding LoadFileHistoryCommand}" ToolTip.Tip="{Binding Strings.LoadFileHistory.Text}">
        <SplitButton.Resources>
          <!-- A narrow drop down arrow, as the ToolStripSplitButton (the Fluent one is 32 wide). -->
          <x:Double x:Key="SplitButtonSecondaryButtonSize">20</x:Double>
        </SplitButton.Resources>
        <Image Source="avares://GitUI.Avalonia/Assets/ReloadRevisions.png" Width="16" Height="16" />
        <SplitButton.Flyout>
          <MenuFlyout>
            <MenuItem Name="loadHistoryOnShowItem" Header="{Binding Strings.LoadHistoryOnShow.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding LoadHistoryOnShow}" />
            <MenuItem Name="loadBlameOnShowItem" Header="{Binding Strings.LoadBlameOnShow.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding LoadBlameOnShow}" IsEnabled="{Binding IsBlameTabVisible}" />
          </MenuFlyout>
        </SplitButton.Flyout>
      </SplitButton>
      <DropDownButton Name="fullHistoryButton" Classes="toolbar" ToolTip.Tip="{Binding Strings.ShowFullHistoryToolTip.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/FileHistory.png" Width="16" Height="16" />
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Name="showFullHistoryItem" Header="{Binding Strings.ShowFullHistory.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding FullHistory}" />
            <MenuItem Name="simplifyMergesItem" Header="{Binding Strings.SimplifyMerges.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding SimplifyMerges}" IsEnabled="{Binding FullHistory}" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <DropDownButton Name="blameOptionsButton" Classes="toolbar" ToolTip.Tip="{Binding Strings.BlameOptions.Text}" IsVisible="{Binding HasBlame}">
        <Image Source="avares://GitUI.Avalonia/Assets/Blame.png" Width="16" Height="16" />
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Classes="caption" Header="{Binding Strings.BlameSettings.AccessKeyText}" />
            <MenuItem Header="{Binding Strings.IgnoreWhitespace.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding IgnoreWhitespaceOnBlame}" />
            <MenuItem Header="{Binding Strings.DetectMoveAndCopyInThisFile.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding DetectCopyInFileOnBlame}" />
            <MenuItem Header="{Binding Strings.DetectMoveAndCopyInAllFiles.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding DetectCopyInAllOnBlame}" />
            <Separator />
            <MenuItem Classes="caption" Header="{Binding Strings.DisplaySettings.AccessKeyText}" />
            <MenuItem Header="{Binding Strings.DisplayAuthorFirst.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding BlameDisplayAuthorFirst}" />
            <MenuItem Header="{Binding Strings.ShowAuthorAvatar.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding BlameShowAuthorAvatar}" />
            <MenuItem Header="{Binding Strings.ShowAuthor.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding BlameShowAuthor}" />
            <MenuItem Header="{Binding Strings.ShowAuthorDate.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding BlameShowAuthorDate}" />
            <MenuItem Header="{Binding Strings.ShowAuthorTime.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding BlameShowAuthorTime}" IsEnabled="{Binding BlameShowAuthorDate}" />
            <MenuItem Header="{Binding Strings.ShowLineNumbers.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding BlameShowLineNumbers}" />
            <MenuItem Header="{Binding Strings.ShowOriginalFilePath.AccessKeyText}" ToggleType="CheckBox" IsChecked="{Binding BlameShowOriginalFilePath}" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Name="gitCommandLogButton" Classes="toolbar" Command="{Binding ShowGitCommandLogCommand}" ToolTip.Tip="{Binding Strings.GitCommandLog.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/GitCommandLog.png" Width="16" Height="16" />
      </Button>
      <!-- As InsertRevisionGridMainMenuItems: the Navigate and View menus of the grid. -->
      <DropDownButton Name="navigateMenuButton" Classes="toolbar" Content="{Binding MenuStrings.NavigateMenu.PlainText}"
                      IsVisible="{Binding NavigateMenuProvider, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <DropDownButton Name="viewMenuButton" Classes="toolbar" Content="{Binding MenuStrings.ViewMenu.PlainText}"
                      IsVisible="{Binding ViewMenuProvider, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <rg:FilterToolBarView Name="filterToolBar" DataContext="{Binding Filters}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
    <Grid RowDefinitions="220,Auto,*">
      <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" IsVisible="{Binding IsGridVisible}">
        <rg:RevisionGridView Name="revisionGrid" DataContext="{Binding Grid}">
          <rg:RevisionGridView.ContextMenu>
            <!-- Equivalent of FileHistoryContextMenu (the navigate and view menus of the grid are not ported yet). -->
            <ContextMenu Name="gridMenu">
              <MenuItem Name="copyToClipboardItem">
                <MenuItem.Icon>
                  <Image Source="avares://GitUI.Avalonia/Assets/CopyToClipboard.png" Width="16" Height="16" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Name="openWithDifftoolItem">
                <MenuItem.Icon>
                  <Image Source="avares://GitUI.Avalonia/Assets/Diff.png" Width="16" Height="16" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Name="diffToolRemoteLocalItem" />
              <MenuItem Name="saveAsItem">
                <MenuItem.Icon>
                  <Image Source="avares://GitUI.Avalonia/Assets/SaveAs.png" Width="16" Height="16" />
                </MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Name="manipulateCommitItem">
                <MenuItem Name="revertCommitItem">
                  <MenuItem.Icon>
                    <Image Source="avares://GitUI.Avalonia/Assets/RevertCommit.png" Width="16" Height="16" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Name="cherryPickItem">
                  <MenuItem.Icon>
                    <Image Source="avares://GitUI.Avalonia/Assets/CherryPick.png" Width="16" Height="16" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuItem>
              <Separator />
              <MenuItem Name="followRenamesItem" ToggleType="CheckBox" />
              <MenuItem Name="followRenamesExactOnlyItem" ToggleType="CheckBox" />
            </ContextMenu>
          </rg:RevisionGridView.ContextMenu>
        </rg:RevisionGridView>
      </Border>
      <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" Background="Transparent" />
      <TabControl Name="tabs" Grid.Row="2" Padding="0,4,0,0">
        <TabItem Name="commitTab" IsVisible="{Binding IsCommitTabVisible}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/CommitSummary.png" Width="16" Height="16" />
              <TextBlock Text="{Binding CommitTabHeader}" />
            </StackPanel>
          </TabItem.Header>
          <!-- Equivalent of the CommitDiff control. -->
          <Grid DataContext="{Binding CommitDiff}" RowDefinitions="170,Auto,*" x:DataType="hd:CommitDiffViewModel">
            <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
              <c:CommitInfoView Name="commitInfo" DataContext="{Binding CommitInfo}" />
            </Border>
            <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" Background="Transparent" />
            <Grid Grid.Row="2" ColumnDefinitions="260,Auto,*">
              <fs:FileStatusListView Name="commitFiles" DataContext="{Binding Files}" />
              <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent" />
              <Border Grid.Column="2" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                <ed:FileViewerView Name="commitDiffText" DataContext="{Binding Viewer}" />
              </Border>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Name="diffTab" IsVisible="{Binding IsDiffTabVisible}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Diff.png" Width="16" Height="16" />
              <TextBlock Text="{Binding Strings.DiffTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ed:FileViewerView Name="diffText" DataContext="{Binding Diff}" />
          </Border>
        </TabItem>
        <TabItem Name="viewTab" IsVisible="{Binding IsViewTabVisible}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/ViewFile.png" Width="16" Height="16" />
              <TextBlock Text="{Binding Strings.ViewTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <Border BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <ed:FileViewerView Name="viewText" DataContext="{Binding View}" />
          </Border>
        </TabItem>
        <TabItem Name="blameTab" IsVisible="{Binding IsBlameTabVisible}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Source="avares://GitUI.Avalonia/Assets/Blame.png" Width="16" Height="16" />
              <TextBlock Text="{Binding Strings.BlameTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <b:BlameView Name="blame" DataContext="{Binding Blame}" />
        </TabItem>
        <!-- BuildReportTabPageExtension: the report of the build status of the selected revision, or a link to it. -->
        <TabItem Name="buildReportTab" x:DataType="vm:BuildReportViewModel" DataContext="{Binding $parent[Window].((vm:FileHistoryViewModel)DataContext).BuildReport}"
                 IsVisible="{Binding HasBuildReport, FallbackValue=False}">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Panel Width="16" Height="16">
                <Image Width="16" Height="16" Source="avares://GitUI.Avalonia/Assets/Integration.png" IsVisible="{Binding BuildReportIcon, Converter={x:Static ObjectConverters.IsNull}}" />
                <Image Name="buildReportIcon" Source="{Binding BuildReportIcon, Converter={x:Static rg:AvatarConverter.Instance}}"
                       IsVisible="{Binding BuildReportIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </Panel>
              <TextBlock Text="{Binding Strings.BuildReportTab.PlainText}" />
            </StackPanel>
          </TabItem.Header>
          <Panel>
            <c:EmbeddedNativeViewPresenter Name="buildReportView" View="{Binding BuildReportView}" IsVisible="{Binding IsBuildReportInTab}" />
            <Button Name="openBuildReport" Classes="link" Command="{Binding OpenBuildReportCommand}" IsVisible="{Binding !IsBuildReportInTab}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand">
              <TextBlock Text="{Binding Strings.OpenReport.Text}" FontSize="21" TextDecorations="Underline"
                         Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
            </Button>
          </Panel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</h:DialogWindow>
