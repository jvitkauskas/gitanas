<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs"
                x:Class="GitUI.Avalonia.CommandsDialogs.ReflogWindow"
                x:DataType="vm:ReflogViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="782" Height="555" MinWidth="500" MinHeight="300">
  <DockPanel Margin="9">
    <TextBlock Name="dirtyWarning" DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" TextAlignment="Center"
               Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
               Text="{Binding Strings.DirtyWorkingDirectory.Text}" IsVisible="{Binding IsDirty}" />
    <!-- Equivalent of branchesPanel and currentBranchPanel, the two auto-sized columns of tableLayoutPanel1. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6" Orientation="Horizontal" Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Label Content="{Binding Strings.Reference.AccessKeyText}" Target="referencesComboBox" VerticalAlignment="Center" Padding="0" />
        <ComboBox Name="referencesComboBox" MinWidth="250" ItemsSource="{Binding References}" SelectedItem="{Binding SelectedReference}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="{Binding Strings.DisplayReflogFor.Text}" VerticalAlignment="Center" />
        <Button Name="currentBranchLink" Classes="link" Command="{Binding ShowCurrentBranchCommand}" IsVisible="{Binding IsBranchCheckedOut}">
          <TextBlock Text="{Binding CurrentBranchText}" />
        </Button>
        <Button Name="headLink" Classes="link" Command="{Binding ShowHeadCommand}">
          <TextBlock Text="{Binding Strings.Head.Text}" />
        </Button>
      </StackPanel>
    </StackPanel>
    <DataGrid Name="reflogGrid" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
              IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="False"
              HeadersVisibility="Column" GridLinesVisibility="All" BorderThickness="1"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DataGrid.ContextMenu>
        <ContextMenu Name="reflogContextMenu">
          <MenuItem Name="copyShaMenuItem" Header="{Binding Strings.CopySha.AccessKeyText}" Command="{Binding CopyShaCommand}">
            <MenuItem.Icon>
              <Image Width="16" Height="16" Source="avares://GitUI.Avalonia/Assets/CommitId.png" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Name="createBranchMenuItem" Header="{Binding Strings.CreateBranch.AccessKeyText}" Command="{Binding CreateBranchCommand}">
            <MenuItem.Icon>
              <Image Width="16" Height="16" Source="avares://GitUI.Avalonia/Assets/BranchCreate.png" />
            </MenuItem.Icon>
          </MenuItem>
          <MenuItem Name="resetMenuItem" Header="{Binding Strings.ResetCurrentBranch.AccessKeyText}" Command="{Binding ResetCurrentBranchCommand}">
            <MenuItem.Icon>
              <Image Width="16" Height="16" Source="avares://GitUI.Avalonia/Assets/ResetCurrentBranchToHere.png" />
            </MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn Width="Auto" SortMemberPath="Sha">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:ReflogEntry">
              <TextBlock Text="{Binding Sha}" FontFamily="{DynamicResource MonospaceFontFamily}" VerticalAlignment="Center" Margin="12,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding Ref}" Width="Auto" x:DataType="vm:ReflogEntry" />
        <DataGridTextColumn Binding="{Binding Action}" Width="*" x:DataType="vm:ReflogEntry" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</h:DialogWindow>
