<h:DialogWindow xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:h="using:GitUI.Avalonia.Hosting"
                xmlns:vm="using:GitUI.Presentation.CommandsDialogs.SettingsDialog"
                x:Class="GitUI.Avalonia.CommandsDialogs.SettingsDialog.ChooseTranslationWindow"
                x:DataType="vm:ChooseTranslationViewModel"
                Title="{Binding Strings.Title.PlainText}"
                Width="440" Height="500" MinWidth="320" MinHeight="300">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
        <Button Name="cancelButton" IsCancel="True"
                Content="{Binding Strings.Cancel.AccessKeyText}" Command="{Binding CancelCommand}" />
        <Button Name="okButton" Classes="accent" IsDefault="True"
                Content="{Binding Strings.Ok.AccessKeyText}" Command="{Binding ChooseCommand}" />
      </StackPanel>
    </Border>
    <DockPanel Margin="12">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
        <Label Content="{Binding Strings.ChooseLanguage.AccessKeyText}" Target="translationsListBox" FontWeight="SemiBold" Padding="0" />
        <TextBlock Text="{Binding Strings.ChangeLater.Text}" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox Name="translationsListBox" ItemsSource="{Binding Translations}" SelectedItem="{Binding Language}"
               SelectionMode="Single" />
    </DockPanel>
  </DockPanel>
</h:DialogWindow>
