<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lp="using:GitUI.Presentation.UserControls.LeftPanel"
             xmlns:local="using:GitUI.Avalonia.Controls.LeftPanel"
             xmlns:h="using:GitUI.Avalonia.Hosting"
             xmlns:ft="using:GitUI.Avalonia.Controls.FlatTree"
             x:Class="GitUI.Avalonia.Controls.LeftPanel.LeftPanelView"
             x:DataType="lp:LeftPanelViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox#tree ListBoxItem">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="2,1" />
    </Style>
    <Style Selector="TextBlock.grayed">
      <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    </Style>
    <!-- As the search results of RepoObjectsTree (SystemColors.Info), translucent to suit both themes. -->
    <Style Selector="Border.match">
      <Setter Property="Background" Value="#60FFD800" />
    </Style>
    <Style Selector="Button.toolbar, ToggleButton.toolbar">
      <Setter Property="Padding" Value="3" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>
  <!-- Equivalent of RepoObjectsTree: the toolbar of the trees (leftPanelToolStrip), the search box (branchSearchPanel) and the tree (treeMain). -->
  <DockPanel>
    <StackPanel Name="toolbar" DockPanel.Dock="Top" Orientation="Horizontal" Spacing="1" Margin="0,0,0,2">
      <Button Name="collapseAllButton" Classes="toolbar" Command="{Binding CollapseAllCommand}" ToolTip.Tip="{Binding Strings.CollapseAllToolTip.Text}">
        <Image h:ImageLightness.Adapt="True" Source="avares://GitUI.Avalonia/Assets/CollapseAll.png" Width="16" Height="16" />
      </Button>
      <ToggleButton Name="showBranchesButton" Classes="toolbar" IsChecked="{Binding ShowBranches}" ToolTip.Tip="{Binding Strings.ShowBranchesToolTip.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/BranchLocalRoot.png" Width="16" Height="16" />
      </ToggleButton>
      <ToggleButton Name="showRemotesButton" Classes="toolbar" IsChecked="{Binding ShowRemotes}" ToolTip.Tip="{Binding Strings.ShowRemotesToolTip.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/BranchRemoteRoot.png" Width="16" Height="16" />
      </ToggleButton>
      <ToggleButton Name="showWorktreesButton" Classes="toolbar" IsChecked="{Binding ShowWorktrees}" ToolTip.Tip="{Binding Strings.ShowWorktreesToolTip.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/WorkTree.png" Width="16" Height="16" />
      </ToggleButton>
      <ToggleButton Name="showTagsButton" Classes="toolbar" IsChecked="{Binding ShowTags}" ToolTip.Tip="{Binding Strings.ShowTagsToolTip.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/TagHorizontal.png" Width="16" Height="16" />
      </ToggleButton>
      <ToggleButton Name="showSubmodulesButton" Classes="toolbar" IsChecked="{Binding ShowSubmodules}" ToolTip.Tip="{Binding Strings.ShowSubmodulesToolTip.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/FolderSubmodule.png" Width="16" Height="16" />
      </ToggleButton>
      <ToggleButton Name="showStashesButton" Classes="toolbar" IsChecked="{Binding ShowStashes}" ToolTip.Tip="{Binding Strings.ShowStashesToolTip.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/Stash.png" Width="16" Height="16" />
      </ToggleButton>
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
      <AutoCompleteBox Name="searchBox" Text="{Binding SearchText}" ItemsSource="{Binding SearchCandidates}"
                       FilterMode="Contains" MinimumPrefixLength="1" MaxDropDownHeight="300" />
      <Button Name="searchButton" Grid.Column="1" Classes="toolbar" Command="{Binding SearchCommand}" ToolTip.Tip="{Binding Strings.Search.Text}">
        <Image Source="avares://GitUI.Avalonia/Assets/Preview.png" Width="16" Height="16" />
      </Button>
    </Grid>
    <!-- The trees as a virtualizing list of their visible nodes (FlatTreeList), for the thousands of references of a large repository. -->
    <ListBox Name="tree" Background="{DynamicResource WindowBrush}">
      <ListBox.ContextMenu>
        <!-- Equivalent of menuMain: filled for the selection when it opens (contextMenu_Opening). -->
        <ContextMenu Name="treeMenu" />
      </ListBox.ContextMenu>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="ft:FlatTreeRow">
          <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
            <Panel Width="16">
              <ToggleButton Theme="{DynamicResource FluentTreeViewExpandCollapseChevron}" Focusable="False"
                            IsVisible="{Binding HasChildren}" IsChecked="{Binding IsExpanded}" />
            </Panel>
            <ContentControl Content="{Binding Node}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.DataTemplates>
        <DataTemplate DataType="lp:LeftPanelNode">
          <Border Classes.match="{Binding IsSearchMatch}" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Image Width="16" Height="16" Source="{Binding IconKey, Converter={x:Static local:LeftPanelConverters.Icon}}"
                     h:ImageLightness.Adapt="{Binding IconKey, Converter={x:Static local:LeftPanelConverters.AdaptsLightness}}" />
              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" Classes.grayed="{Binding IsGrayed}"
                         FontWeight="{Binding IsBold, Converter={x:Static local:LeftPanelConverters.Bold}}"
                         FontStyle="{Binding IsItalic, Converter={x:Static local:LeftPanelConverters.Italic}}"
                         TextDecorations="{Binding IsMultiSelected, Converter={x:Static local:LeftPanelConverters.Underline}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
  </DockPanel>
</UserControl>
