<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitUI.Avalonia.GitExtensionsAvaloniaApp"
             Name="Gitanas"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Hashes and code; replaced by AppSettings.MonospaceFont, see ApplyOptions. -->
      <FontFamily x:Key="MonospaceFontFamily">Consolas, Cascadia Mono, monospace</FontFamily>
      <!-- The file viewer and editor; replaced by AppSettings.FixedWidthFont, see ApplyOptions. -->
      <FontFamily x:Key="EditorFontFamily">Consolas, Cascadia Mono, monospace</FontFamily>
      <x:Double x:Key="EditorFontSize">13</x:Double>
      <!-- The commit message; replaced by AppSettings.CommitFont, see ApplyOptions. -->
      <FontFamily x:Key="CommitFontFamily">Segoe UI, San Francisco, sans-serif</FontFamily>
      <x:Double x:Key="CommitFontSize">12</x:Double>
      <!-- The rows of the revision grid; follows the font, see ApplyOptions. -->
      <x:Double x:Key="RevisionGridRowHeight">22</x:Double>
      <!-- Reference colors of the default theme (AppColorDefaults); replaced by the Gitanas theme, see ApplyOptions. -->
      <SolidColorBrush x:Key="AppColor.Branch" Color="#008000" />
      <SolidColorBrush x:Key="AppColor.RemoteBranch" Color="#8B0009" />
      <SolidColorBrush x:Key="AppColor.Tag" Color="#00008B" />
      <SolidColorBrush x:Key="AppColor.OtherTag" Color="#808080" />
      <!-- SystemColors.Info (the tooltip yellow) of the WinForms info boxes, adapted to dark themes. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FFFFE1" />
          <!-- SystemColors.Window and Control; replaced by the Gitanas theme, see ApplyColors. -->
          <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ControlBrush" Color="#F0F0F0" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#3D3B24" />
          <SolidColorBrush x:Key="WindowBrush" Color="#202020" />
          <SolidColorBrush x:Key="ControlBrush" Color="#2B2B2B" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <!-- The control theme (Fluent, compact) and its styles of the DataGrid, color picker and editor are added first, in
         code: see GitExtensionsAvaloniaApp.ControlTheme.cs. -->
    <StyleInclude Source="avares://AvaloniaHex/Themes/Simple/AvaloniaHex.axaml" />

    <!-- Equivalent of GitExtensionsDialog.ControlsPanel: the OK/Cancel strip at the bottom of a dialog. -->
    <Style Selector="Border.dialogFooter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="Padding" Value="9,8" />
    </Style>
    <Style Selector="Border.dialogFooter Button">
      <Setter Property="MinWidth" Value="75" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!--
      The text of combo boxes at the inset of the text boxes (5 pixels) and centered: Fluent's compact combo box had 12 on the
      left and 1 above / 3 below, and its editable text box drew the text 2 or 3 pixels above the middle.
    -->
    <Style Selector="ComboBox">
      <Setter Property="Padding" Value="5,2,0,2" />
    </Style>
    <Style Selector="ComboBox /template/ TextBox#PART_EditableTextBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- The one-line text boxes centered too (the text was drawn at the top of their content); multi-line ones keep the top. -->
    <Style Selector="TextBox[AcceptsReturn=False]">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      The drop-down arrows of the toolbar buttons as small as the WinForms ones (the ToolStripSplitButton arrow): Fluent gives
      the arrow of a split button a button of at least 32 pixels, and the one of a drop-down button a margin of 10.
    -->
    <Style Selector="SplitButton.toolbar /template/ Button#PART_PrimaryButton">
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="SplitButton.toolbar /template/ Button#PART_SecondaryButton">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="3,0" />
    </Style>
    <Style Selector="SplitButton.toolbar /template/ Button#PART_SecondaryButton PathIcon">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
    </Style>
    <Style Selector="DropDownButton.toolbar /template/ PathIcon#DropDownGlyph">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- Tooltips as wide as the WinForms ones: Fluent's 320 pixels wrapped the lines of commit messages again. -->
    <Style Selector="ToolTip">
      <Setter Property="MaxWidth" Value="600" />
    </Style>

    <!-- Equivalent of ToolStripSeparator: a vertical line between the groups of a toolbar (Fluent draws a separator as a
         horizontal line of 1 pixel, a dot with Width="1"). -->
    <Style Selector="Separator.toolbar">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    </Style>

    <!--
      Tab headers as the WinForms tabs: bordered, the selected one in the color of the window, without Fluent's underline
      (not the tabs of the color view, which have their own look).
    -->
    <Style Selector="TabControl:not(#PART_TabControl) TabItem">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="3,3,0,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="TabControl:not(#PART_TabControl) TabItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="TabControl:not(#PART_TabControl) TabItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
    </Style>
    <Style Selector="TabControl:not(#PART_TabControl) TabItem /template/ Border#PART_SelectedPipe, TabControl:not(#PART_TabControl) TabItem:selected /template/ Border#PART_SelectedPipe">
      <!-- Fluent shows it for the selected tab (its IsVisible and Background win over the styles): transparent instead. -->
      <Setter Property="Opacity" Value="0" />
    </Style>

    <!-- Fluent's pivot-style tab headers are sized for touch; use desktop proportions. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Equivalent of the WinForms boxes with the SystemColors.Info background (hints, messages). -->
    <Style Selector="Border.info">
      <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="TextBox.info">
      <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox.info:pointerover /template/ Border#PART_BorderElement, TextBox.info:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}" />
    </Style>

    <!-- Labels in form grids line up with their inputs. -->
    <Style Selector="Grid.form > Label">
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      Check box with the caption before the box (WinForms CheckBox.RightToLeft = Yes): the check box is mirrored
      with FlowDirection, and its glyph is mirrored back so that the check mark is drawn correctly.
    -->
    <Style Selector="CheckBox.captionFirst">
      <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>
    <Style Selector="CheckBox.captionFirst /template/ Path">
      <Setter Property="FlowDirection" Value="LeftToRight" />
    </Style>

    <!-- Grids use the dialog font and the row height of the compact density (Fluent's DataGrid is sized for touch). -->
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
      <Setter Property="MinHeight" Value="26" />
    </Style>

    <!-- Link-style buttons, the equivalent of WinForms LinkLabel. -->
    <Style Selector="Button.link">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHyperlinkTextBrush}" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SystemControlHyperlinkBaseMediumBrush}" />
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="TextDecorations" Value="Underline" />
    </Style>
  </Application.Styles>
</Application>
