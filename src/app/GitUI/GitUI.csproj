<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>

    <!--
    For debug purposes uncomment these lines:

    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
    -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\GitExtUtils\Validates.cs" Link="Utils\Validates.cs" />
    <!-- The layout of the revision graph is compiled by GitUI.RevisionGraph (docs/avalonia-port/PLAN.md, phase 4). -->
    <Compile Remove="UserControls\RevisionGrid\Graph\*.cs" />
    <Compile Include="UserControls\RevisionGrid\Graph\RevisionGraphLaneColor.cs;UserControls\RevisionGrid\Graph\LaneInfoProvider.cs;UserControls\RevisionGrid\Graph\BranchFinder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EnvDTE" />
    <PackageReference Include="ExCSS" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JetBrains.Annotations" />
    <!-- The build report tab of the Avalonia main window (docs/avalonia-port/PLAN.md, phase 8): only the Core API is used. -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\externals\ConEmuInside\ConEmuInside.csproj" />
    <ProjectReference Include="..\..\..\externals\Git.hub\Git.hub\Git.hub.csproj" />
    <ProjectReference Include="..\..\..\externals\NetSpell.SpellChecker\SpellChecker.csproj" />
    <ProjectReference Include="..\BugReporter\BugReporter.csproj" />
    <ProjectReference Include="..\GitCommands\GitCommands.csproj" />
    <ProjectReference Include="..\GitExtUtils\GitExtUtils.csproj" />
    <ProjectReference Include="..\GitUI.Avalonia\GitUI.Avalonia.csproj" />
    <ProjectReference Include="..\GitUI.RevisionGraph\GitUI.RevisionGraph.csproj" />
    <ProjectReference Include="..\ResourceManager\ResourceManager.csproj" />
    <ProjectReference Include="..\..\plugins\GitUIPluginInterfaces\GitUIPluginInterfaces.csproj" />
  </ItemGroup>

