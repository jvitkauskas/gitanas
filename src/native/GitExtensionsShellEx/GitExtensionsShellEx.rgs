HKCR
{
    NoRemove CLSID
    {
        ForceRemove {c058a8b1-7307-5439-a0e8-676b85d54f6f} = s 'Gitanas Shell Extension'
        {
            InprocServer32 = s '%MODULE%'
            {
                val ThreadingModel = s 'Apartment'
            }
        }
    }
    NoRemove txtfile
    {
        NoRemove ShellEx
        {
            NoRemove ContextMenuHandlers
            {
                ForceRemove Gitanas = s '{c058a8b1-7307-5439-a0e8-676b85d54f6f}'
            }
        }
    }
}
